{
    "expo": {
        "name": "Covara Worker Mobile",
        "slug": "covara-one",
        "owner": "chorkos-organization",
        "version": "0.1.0",
        "icon": "./assets/icon.png",
        "orientation": "portrait",
        "scheme": "covara",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#041A16"
        },
        "platforms": ["ios", "android"],
        "android": {
            "package": "com.covara.worker",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#041A16"
            },
            "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION"
            ]
        },
        "ios": {
            "bundleIdentifier": "com.covara.worker",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "NSLocationWhenInUseUsageDescription": "Covara uses your location to validate claims and detect local risk conditions."
            }
        },
        "extra": {
            "eas": {
                "projectId": "fdc7c955-29ee-4124-9ab2-3d4076983a8e"
            }
        },
        "plugins": [
            "expo-asset",
            [
                "expo-build-properties",
                {
                    "android": {
                        "kotlinVersion": "2.0.21"
                    }
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Covara uses your location to validate claims and detect local risk conditions.",
                    "isIosBackgroundLocationEnabled": false,
                    "isAndroidBackgroundLocationEnabled": false
                }
            ],
            "expo-secure-store"
        ]
    }
}
